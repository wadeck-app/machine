{
  "name": "@wadeck-app/machine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:relay": "npm run test:relay --workspace machine-cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "bundle": "npm run bundle --workspace machine-cli",
    "bundle:all": "npm run bundle --workspace machine-cli && npm run bundle:app-module --workspace machine-cli"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=22"
  }
}
