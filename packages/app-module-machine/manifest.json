{
  "id": "machine",
  "title": "Machine",
  "dslLib": {
    "shared": {
      "react": "^19",
      "react-router-dom": "^7",
      "@wadeck-app/dsl-ui": ">=2026.10.3-0",
      "@wadeck-app/dsl-renderer": ">=2026.10.14-0"
    }
  },
  "extensionPoints": [
    {
      "kind": "page",
      "slot": "nav",
      "label": "Machines",
      "path": "/",
      "view": {
        "type": "path",
        "value": "./src/dsl-views/machines.yaml"
      }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Requests",
      "path": "/requests",
      "count": { "route": "/requests", "field": "count" },
      "view": {
        "type": "path",
        "value": "./src/dsl-views/requests.yaml"
      }
    },
    {
      "kind": "page",
      "slot": "nav",
      "label": "Candidacies",
      "path": "/candidacies",
      "count": { "route": "/candidacies", "field": "count" },
      "view": {
        "type": "path",
        "value": "./src/dsl-views/candidacies.yaml"
      }
    }
  ]
}
