package main

// resource.syso (Windows PE version info) is generated by goversioninfo from the SDK's versioninfo.json.

import (
	"fmt"
	"os"
	"os/exec"
	"path/filepath"
	"time"

	launcher "wadeck.ch/singleton-daemon-kit/go-launcher"
)

// machine's own launcher template, passed as the third argument of the SDK's build.sh (see ci/scripts/build-launcher.sh).
// It exists for two reasons the SDK default template does not cover:
//   - the config dir must be the one the Node side uses (packages/machine-cli/src/paths.ts: --config-dir, then
//     MACHINE_CONFIG_DIR, then $XDG_CONFIG_HOME/machine or ~/.config/machine), because the launcher writes its logs, its
//     pid file and its restart sentinel there;
//   - every argument reaches node untouched, in the same order (the SDK default would strip --config and treat a leading
//     absolute path as a config dir; this template uses neither).
//
// Precedence, same as Node:
//   1. --config-dir <dir> before the first "--" (the last one wins, as in cli.ts)
//   2. MACHINE_CONFIG_DIR (when not empty)
//   3. $XDG_CONFIG_HOME/{{.DefaultConfigDir}}
//   4. $HOME/.config/{{.DefaultConfigDir}}
// No legacy migration here: only the CLI itself may move a folder.

const nodeMissingFix = "install Node.js 24 or newer from https://nodejs.org and make sure `node` is in the PATH of the process that starts {{.AppName}} (for a startup job: the PATH of the orch daemon's session), then start it again"

// configDirFromArgs returns the value of the last "--config-dir <dir>" found before the first "--" (everything after it
// belongs to the remote command of `run`). A flag without a value, or whose value starts with "--", is a usage error that
// the Node side reports: it is ignored here so that the launcher never hides it.
func configDirFromArgs(args []string) string {
	found := ""
	for i := 0; i < len(args); i++ {
		if args[i] == "--" {
			break
		}
		if args[i] != "--config-dir" {
			continue
		}
		if i+1 >= len(args) || len(args[i+1]) >= 2 && args[i+1][:2] == "--" {
			continue
		}
		i++
		if args[i] != "" {
			found = args[i]
		}
	}
	return found
}

// resolveConfigDir applies the precedence above. defaultDir is launcher.DefaultConfigDir("{{.DefaultConfigDir}}").
func resolveConfigDir(args []string, envConfigDir string, defaultDir string) string {
	if dir := configDirFromArgs(args); dir != "" {
		return dir
	}
	if envConfigDir != "" {
		return envConfigDir
	}
	return defaultDir
}

// nodeMissingMessage is what the user reads when node cannot be found: the cause, the requirement and the fix.
func nodeMissingMessage(app string, cause error) string {
	return fmt.Sprintf("%s: cannot start, `node` was not found in PATH (%v). %s requires Node.js 24 or newer: %s.", app, cause, app, nodeMissingFix)
}

// checkNode fails with an actionable message when node is not in PATH. The SDK reports the same fact but without the
// version requirement; the version itself is not checked here (it would take one more process and a console window on Windows).
func checkNode(lookPath func(string) (string, error)) error {
	if _, err := lookPath("node"); err != nil {
		return fmt.Errorf("%s", nodeMissingMessage("{{.AppName}}", err))
	}
	return nil
}

// reportNodeMissing writes the message on stderr and, because the Windows launcher is a GUI program whose stderr is lost
// when orch starts it, in the same daily log file as the SDK (<configDir>/logs/YYYY-MM-DD-launcher.log).
func reportNodeMissing(configDir string, err error) {
	line := fmt.Sprintf("[%s] [ERROR] [launcher] %v\n", time.Now().Format("15:04:05"), err)
	_, _ = fmt.Fprint(os.Stderr, line)
	logsDir := filepath.Join(configDir, "logs")
	if mkErr := os.MkdirAll(logsDir, 0o755); mkErr != nil {
		return
	}
	f, openErr := os.OpenFile(filepath.Join(logsDir, time.Now().Format("2006-01-02")+"-launcher.log"), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
	if openErr != nil {
		return
	}
	_, _ = f.WriteString(line)
	_ = f.Close()
}

func main() {
	args := os.Args[1:]
	configDir := resolveConfigDir(args, os.Getenv("MACHINE_CONFIG_DIR"), launcher.DefaultConfigDir("{{.DefaultConfigDir}}"))

	if err := checkNode(exec.LookPath); err != nil {
		reportNodeMissing(configDir, err)
		os.Exit(1)
	}

	launcher.Run(launcher.Config{
		ConfigDir: configDir,
		// Untouched: node gets exactly what the user typed, including --config-dir and everything after "--".
		Args: args,
		// Passed through unresolved: the SDK handles the env override, a path next to the launcher, and npm package
		// specifiers such as "@wadeck-app/machine-cli/machine.cjs".
		NodeScript: "{{.NodeScript}}",
		AppName:    "{{.AppName}}",
		CLIFlags: []string{
{{range .CLIFlags}}			"{{.}}",
{{end}}		},
		SilentFlags: []string{
{{range .SilentFlags}}			"{{.}}",
{{end}}		},
		UpdateCmd: []string{
{{range .UpdateCmd}}			"{{.}}",
{{end}}		},
	})
}
